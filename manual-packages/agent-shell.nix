  version = "1778678932";

  src = fetchFromGitHub {
    owner = "dezzw";
    repo = "agent-shell";
    rev = "32a31de7c2979c9992abf5c26f0dfa1943bc82d9";
    hash = "sha256-ZdONCCUr601vavsU0Cgi7hSIOOrUNhyUAE0fQHtQvUs=";
  };

  packageRequires = [
    shell-maker
    acp
  ];

  meta = with lib; {
