#!/usr/bin/env nix-shell
#! nix-shell -i bash -p curl xmlstarlet nix coreutils 'python3.withPackages(ps: [ ps.packaging ])' nix-prefetch-git jq
set -euxo pipefail

SCRIPTPATH="$( cd "$(dirname "$0")" ; pwd -P )"
cd $SCRIPTPATH

# Savannah's git HTTP endpoint currently redirects to a broken URL and often
# returns HTTP 500. The emacs-mirror GitHub repo tracks the same branches.
EMACS_GIT_OWNER="emacs-mirror"
EMACS_GIT_REPO="emacs"

function update_github_branch() {
    local branch="$1"
    local url="https://github.com/${EMACS_GIT_OWNER}/${EMACS_GIT_REPO}.git"

    echo "emacs $branch"

    local commit_sha
    commit_sha=$(git ls-remote --branches "$url" "refs/heads/$branch" | cut -f1)

    if [ -z "$commit_sha" ]; then
        echo "Failed to resolve branch '$branch' from $url" >&2
        return 1
    fi

    local source_info
    source_info=$(nix-prefetch-git --rev "$commit_sha" "$url")

    local digest
    digest=$(echo "$source_info" | jq -r .sha256)

    # build a version number based on date: YYYYMMDD.0
    local version_number
    version_number="$(echo "$source_info" | jq -r .date | cut -d 'T' -f 1 | sed 's/-//g').0"

    local output_branch
    output_branch=$(echo "$branch" | sed 's/\//_/g')

    echo "{\"type\": \"github\", \"owner\": \"${EMACS_GIT_OWNER}\", \"repo\": \"${EMACS_GIT_REPO}\", \"rev\": \"${commit_sha}\", \"sha256\": \"${digest}\", \"version\": \"${version_number}\"}" > "emacs-${output_branch}.json"
}

update_github_branch master
update_github_branch feature/igc3

nix-build --no-out-link --show-trace ./test.nix
